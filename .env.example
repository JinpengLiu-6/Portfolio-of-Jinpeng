# Server-only values. Never prefix these with VITE_ or commit real credentials.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR-WRITE-TOKEN
